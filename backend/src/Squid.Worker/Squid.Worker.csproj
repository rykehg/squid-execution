<Project Sdk="Microsoft.NET.Sdk">

  <!-- CPU-heavy work: media, backup, cipher, Reed-Solomon (doc 05 §4.6). A composition root,
       isolated from the silo scheduler. A console app on the shared framework rather than
       Microsoft.NET.Sdk.Worker: that SDK pulls Microsoft.Extensions.Hosting in through a
       PackageReference, and every version in this solution is pinned centrally (ADR-25) with
       no package yet (GAP-02). The hosted-service shape arrives with the first real worker. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squid.Domain\Squid.Domain.csproj" />
    <ProjectReference Include="..\Squid.Persistence\Squid.Persistence.csproj" />
    <ProjectReference Include="..\Squid.Protocols\Squid.Protocols.csproj" />
  </ItemGroup>

</Project>