<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- GAP-02: public nuget.org is the only source, and it is declared here so the backend
       restores the same way on every machine (doc 05 §11). A closed network is the reason a
       local feed may have to be added later; until then, no local path is committed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <config>
    <!-- Packages restore into the solution folder, not into a machine-wide cache. -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>

</configuration>