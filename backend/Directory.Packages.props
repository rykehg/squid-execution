<Project>

  <!-- Central package management (ADR-25): every package version lives here, never in a .csproj.
       A PackageReference in a project carries no Version= attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Storage stack of Squid.Persistence: REQ-0001 fixes the Orleans 10.2 and SQLite 10.0 lines. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />

    <!-- Dapper is the read/query package of the projections (SPEC-0009 section B decision 5 and
         data-model §4; approved by the human gate of 2026-11-09 together with the migration).
         Version lives here and only here (ADR-25). -->
    <PackageVersion Include="Dapper" Version="2.1.89" />

    <!-- Test stack of Squid.Tests; this exact set restores on SDK 10.0.403 (GAP-07). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.Orleans.Core" Version="10.2.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- Silo runtime + dashboard of the service host (SPEC-0002, GAP-08): the Dashboard package
         compatible with Orleans 10.2 was chosen by probing the real API; both sit on the 10.2
         line approved by the human gate of 2026-11-06. -->
    <PackageVersion Include="Microsoft.Orleans.Dashboard" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.2.2" />

    <!-- Observability stack of Squid.Service (SPEC-0002, GAP-09/GAP-10): versions probed against
         the real API outside the repo; approved by the human gate of 2026-11-06. The OTel line is
         pinned as a set (hosting + OTLP exporter + ASP.NET Core instrumentation all 1.20.1) so no
         NU1608 disagreement shows up between them. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />

    <!-- Crypto package of the identity phase (SPEC-0007 GAP-08): BouncyCastle.Cryptography is the
         single crypto dependency (Argon2id + Ed25519), approved by the human gate of 2026-11-07. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />

    <!-- Image pipeline of the media slice (SPEC-0009 section E, decision 3): SkiaSharp is the
         single image package, decode only — the EXIF strip and the blurHash encoder are
         hand-written code (human gate of 2026-11-09, ADR-25). Its own native payload arrives as
         SkiaSharp's transitive dependency, so this stays the only declared image package.
         Version lives here and only here. -->
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />

    <!-- Linux native payload of the same pipeline (human gate 2026-11-10 08:00:15, AC-06 of
         TASK-0028): SkiaSharp brings Win32/macOS natives only, so CI ubuntu and compose would
         throw DllNotFoundException on decode. Same version as SkiaSharp, never a different one. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.155.0" />
  </ItemGroup>

</Project>